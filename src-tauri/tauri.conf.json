{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Blogger Poster",
  "version": "0.1.0",
  "identifier": "dev.puleeno.blogger-poster",
  "build": {
    "beforeDevCommand": "npm --prefix ../ui run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm --prefix ../ui run build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Blogger Poster",
        "width": 1280,
        "height": 840,
        "minWidth": 940,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon-32.png",
      "icons/icon-128.png",
      "icons/icon-256.png",
      "icons/icon-512.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}